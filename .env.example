# ====================================================================
# CHRISTOPHER J. CALLAGHAN PORTFOLIO & WEB APP ENVIRONMENT CONFIG
# Copy this file to `.env` and fill in your actual credentials.
# ====================================================================

# 1. Neon PostgreSQL
# Set this to the connection string from your Neon project when one is created.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# 2. Resend Email API Key
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# Admin email where incoming lead notifications will be sent
ADMIN_EMAIL="hello@christopherjcallaghan.com"

# 3. Google Gemini AI API Key
# Required for real AI Architecture synthesis in AI Tool Studio
# Get your free key from https://aistudio.google.com/
VITE_GEMINI_API_KEY="AIzaSy..."
GEMINI_API_KEY="AIzaSy..."

# 4. Private blog admin
# Set these only in local/server environment configuration, never in client code.
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# 5. App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# 6. Stripe Checkout for online website classes
# Set a Stripe test secret key locally; use your live secret key in production.
STRIPE_SECRET_KEY="sk_test_replace_with_your_test_secret_key"
