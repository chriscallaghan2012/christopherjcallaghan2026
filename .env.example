# ====================================================================
# CHRISTOPHER J. CALLAGHAN PORTFOLIO & WEB APP ENVIRONMENT CONFIG
# Copy this file to `.env.local` and fill in your actual local/test credentials.
# ====================================================================

# 1. Neon PostgreSQL
# Set this to the connection string from your Neon project when one is created.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# 2. Resend Email API Key
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# Address for live form-submission notifications and reply-to
FORM_SUBMISSION_EMAIL="instantonlinesuccess@gmail.com"

# 3. Google Gemini AI API Key
# Required for real AI Architecture synthesis in AI Tool Studio
# Get your free key from https://aistudio.google.com/
VITE_GEMINI_API_KEY="AIzaSy..."
GEMINI_API_KEY="AIzaSy..."

# 4. Private blog admin
# Set these only in local/server environment configuration, never in client code.
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"
CUSTOMER_SESSION_SECRET="use-a-different-random-secret-with-at-least-32-characters"

# 5. App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# 6. Stripe Checkout for online website classes
# Set a Stripe test secret key locally; use your live secret key in production.
STRIPE_SECRET_KEY="sk_test_replace_with_your_test_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_your_test_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_your_stripe_webhook_secret"

# 7. Optional Google OAuth connector (admin control centre)
# Register this callback URL in Google Cloud OAuth settings.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; defaults to the callback URL derived from the request URL.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/admin/control-center/connectors/google/callback"
# 32-byte key encoded as base64; generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# 8. Optional analytics / local-only testing
NEXT_PUBLIC_GTM_ID=""
# Keep false/unset outside local smoke tests. Never enable in deployed environments.
ALLOW_PRIVATE_NETWORK_SCANS="false"
